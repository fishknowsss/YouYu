{
  "name": "youyu",
  "version": "1.5.9",
  "private": true,
  "author": "118 Studio",
  "description": "YouYu Windows proxy desktop app",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:ui": "vite --host 127.0.0.1 --port 5173",
    "assets": "node scripts/run-brand-assets.mjs",
    "cache:electron:win": "node scripts/cache-electron-win.mjs",
    "clean:release": "node scripts/clean-release.mjs",
    "validate:repo": "node scripts/validate-repository-hygiene.mjs",
    "test": "vitest run",
    "test:worker": "node --import tsx --test cloudflare/youyu-traffic/test/*.test.mjs",
    "typecheck:worker": "tsc -p cloudflare/youyu-traffic/tsconfig.json",
    "build:worker": "wrangler deploy --dry-run --config cloudflare/youyu-traffic/wrangler.toml --outdir out/worker",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/run-build.mjs",
    "build:in": "node scripts/run-build.mjs --internal",
    "build:no-pet": "node scripts/run-build.mjs --no-pet",
    "dist:win": "npm run clean:release && npm run assets && npm run build && npm run cache:electron:win && node scripts/run-electron-builder.mjs && npm run validate:release",
    "dist:win:in": "npm run clean:release && npm run assets && npm run build:in && npm run cache:electron:win && node scripts/run-electron-builder.mjs --internal && npm run validate:release:in",
    "dist:win:no": "npm run clean:release && npm run assets && npm run build:no-pet && npm run cache:electron:win && node scripts/run-electron-builder.mjs --no-pet && npm run validate:release:no",
    "dist:win:local": "node scripts/package-windows-local.mjs",
    "dist:win:release": "node scripts/package-windows-release.mjs",
    "validate:release": "tsx scripts/validate-windows-release.ts",
    "validate:release:in": "tsx scripts/validate-windows-release.ts --internal",
    "validate:release:no": "tsx scripts/validate-windows-release.ts --no-pet",
    "validate:release:in:public": "tsx scripts/validate-windows-release.ts --internal --public-update",
    "validate:release:no:public": "tsx scripts/validate-windows-release.ts --no-pet --public-update",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260710.1",
    "@electron/get": "2.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "39.8.9",
    "electron-builder": "26.8.1",
    "electron-vite": "4.0.0",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "7.3.6",
    "vitest": "4.1.5",
    "wrangler": "4.110.0",
    "yaml": "2.8.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
